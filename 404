-- Asset ID Resmi Korblox Deathspeaker R6
local KORBLOX_R6_MESH    = "rbxassetid://101851696"
local KORBLOX_R6_TEXTURE = "rbxassetid://101851254"

-- Asset ID Resmi Korblox Deathspeaker R15
local KORBLOX_R15 = {
    RightUpperLeg = {mesh = "rbxassetid://902942093", texture = "rbxassetid://902829926"},
    RightLowerLeg = {mesh = "rbxassetid://902942096", texture = "rbxassetid://902829926"},
    RightFoot     = {mesh = "rbxassetid://902942101", texture = "rbxassetid://902829926"}
}

local function getSafeParentGui()
    if gethui then
        return gethui()
    end
    local success, coreGui = pcall(function() return game:GetService("CoreGui") end)
    if success and coreGui then
        return coreGui
    end
    return player:WaitForChild("PlayerGui", 5)
end

local function loadAsset(id)
    local getobj = getobjects or (game.GetObjects)
    if getobj then
        local success, objects = pcall(function()
            return getobj(game, "rbxassetid://" .. id)
        end)
        if success and objects and #objects > 0 then
            return objects[1]
        end
    end

    local success2, model2 = pcall(function()
        return InsertService:LoadAsset(id)
    end)
    if success2 and model2 then
        return model2
    end

    return nil
end

local function applyHeadless(character, enable)
    if not character then return end
    local head = character:WaitForChild("Head", 3)
    if head then
        head.Transparency = enable and 1 or 0
        local face = head:FindFirstChildOfClass("Decal")
        if face then
            face.Transparency = enable and 1 or 0
        end
    end
end

local function applyKorblox(character, enable)
    if not character then return end
    local humanoid = character:WaitForChild("Humanoid", 3)
    if not humanoid then return end

    if humanoid.RigType == Enum.HumanoidRigType.R15 then
        for partName, data in pairs(KORBLOX_R15) do
            local part = character:FindFirstChild(partName)
            if part and part:IsA("MeshPart") then
                if enable then
                    if not part:FindFirstChild("OriginalMeshId") then
                        local origMesh = Instance.new("StringValue", part)
                        origMesh.Name = "OriginalMeshId"
                        origMesh.Value = part.MeshId
                        local origTex = Instance.new("StringValue", part)
                        origTex.Name = "OriginalTextureId"
                        origTex.Value = part.TextureID
                    end
                    part.MeshId = data.mesh
                    part.TextureID = data.texture
                else
                    local origMesh = part:FindFirstChild("OriginalMeshId")
                    local origTex = part:FindFirstChild("OriginalTextureId")
                    if origMesh then part.MeshId = origMesh.Value end
                    if origTex then part.TextureID = origTex.Value end
                end
            end
        end
    elseif humanoid.RigType == Enum.HumanoidRigType.R6 then
        local rightLeg = character:FindFirstChild("Right Leg")
        if rightLeg then
            if enable then
                rightLeg.Transparency = 1

                local oldVisual = character:FindFirstChild("KorbloxR6VisualLeg")
                if oldVisual then oldVisual:Destroy() end

                local visualLeg = Instance.new("Part")
                visualLeg.Name = "KorbloxR6VisualLeg"
                visualLeg.Size = Vector3.new(1, 2, 1)
                visualLeg.CanCollide = false
                visualLeg.Massless = true
                visualLeg.CFrame = rightLeg.CFrame

                local mesh = Instance.new("SpecialMesh")
                mesh.Name = "KorbloxMesh"
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = KORBLOX_R6_MESH
                mesh.TextureId = KORBLOX_R6_TEXTURE
                mesh.Scale = Vector3.new(1, 1, 1)
                mesh.Parent = visualLeg

                local weld = Instance.new("WeldConstraint")
                weld.Name = "KorbloxWeld"
                weld.Part0 = rightLeg
                weld.Part1 = visualLeg
                weld.Parent = visualLeg

                visualLeg.Parent = character
            else
                rightLeg.Transparency = 0
                local visualLeg = character:FindFirstChild("KorbloxR6VisualLeg")
                if visualLeg then
                    visualLeg:Destroy()
                end
            end
        end
    end
end

local function applyCrown(character)
    if not character then return end

    local existingCrown = character:FindFirstChild("Local8BitCrown")
    if not crownActive then
        if existingCrown then
            existingCrown:Destroy()
        end
        return
    end

    local head = character:WaitForChild("Head", 3)
    if not head then return end

    if existingCrown then
        existingCrown:Destroy()
    end

    local loadedObject = loadAsset(CROWN_ID)
    if not loadedObject then return end

    local accessory = loadedObject:IsA("Accessory") and loadedObject or loadedObject:FindFirstChildOfClass("Accessory")
    if not accessory then accessory = loadedObject end

    accessory.Name = "Local8BitCrown"
    local handle = accessory:FindFirstChild("Handle") or accessory:FindFirstChildWhichIsA("BasePart", true)

    if handle then
        handle.CanCollide = false

        local mesh = handle:FindFirstChildOfClass("SpecialMesh")
        local originalMeshScale = mesh and mesh.Scale or Vector3.new(1, 1, 1)
        local originalSize = handle.Size

        if mesh then
            mesh.Scale = originalMeshScale * currentScale
        else
            handle.Size = originalSize * currentScale
        end

        local weld = Instance.new("Weld")
        weld.Name = "CrownWeld"
        weld.Part0 = head
        weld.Part1 = handle
        weld.C0 = CFrame.new(0, heightOffset, 0)
        weld.Parent = handle

        accessory.Parent = character
    end
end

local function setupCharacter(character)
    task.wait(0.2)
    -- Dijalankan dalam thread terpisah agar tidak saling memblokir jika terjadi kegagalan muat
    task.spawn(function() applyCrown(character) end)
    task.spawn(function() applyHeadless(character, headlessActive) end)
    task.spawn(function() applyKorblox(character, korbloxActive) end)
end

local function createCorner(parent, radius)
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 6)
    corner.Parent = parent
    return corner
end

